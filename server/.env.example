# Ключи Telegram (my.telegram.org). По умолчанию берутся из .env в корне проекта.
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres из docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USER=gifts
DB_PASSWORD=gifts
DB_NAME=gifts

# API слушает только localhost; 0.0.0.0 открывает его всей сети — без авторизации!
HOST=127.0.0.1
PORT=3000
LIVE_TRADES_MS=20000
LIVE_FLOORS_MS=60000
